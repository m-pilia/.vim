{
    "Argument parser": {
        "prefix": "argparse",
        "decription": "Simple argument parser",
        "body": [
            "while [[ \"\\$#\" -gt 0 ]]; do case \\$1 in",
            "\t${1:-o|--option}) ${2:option=1};;${0}",
            "\t*) echo \"Unknown parameter: ${1}\"; exit 1;;",
            "esac; shift; done"
        ]
    },

    "Script directory": {
        "prefix": "scriptdir",
        "description": "Store path to the script in a variable",
        "body": "SCRIPT_DIR=\"\\$(cd \"\\$(dirname \"\\${BASH_SOURCE[0]}\")\" >/dev/null 2>&1 && pwd)\""
    },

    "Error printer": {
        "prefix": "errorprinter",
        "description" : "Print context around an error",
        "body": [
            "set -Ee",
            "",
            "function print_error_context() {",
            "\t>&2 echo",
            "\t>&2 echo \"\\$0: Error at line \\$1\"",
            "\tawk -v l=\"\\$1\" 'NR > (l - 5) && NR < (l + 4) {printf \"%-5d%4s%s\\n\", NR, (NR == l ? \">>> \" : \"\"), \\$0}' \"\\$0\"",
            "}",
            "",
            "trap 'print_error_context \\$LINENO' ERR",
            "$0"
        ]
    },

    "Parallel batch": {
        "prefix": "parallelbatch",
        "description": "Parallel execution in subshells",
        "body": [
            "BATCH_SIZE=${1:4}",
            "(",
            "for ${2:f} in $3; do",
            "\t((i = i % BATCH_SIZE)); ((i++ == 0)) && wait",
            "\t${4:echo \"$f\"} &",
            "done",
            ")"
        ]
    },

    "While read": {
        "prefix": "whileread",
        "description": "Iterate with while-read",
        "body": [
            "while IFS= read -r ${1:line}",
            "do",
            "\t${3:echo \"Line: \\$line\"}",
            "done < <(${2:find . -name foo})"
        ]
    }
}
